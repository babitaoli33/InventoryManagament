@{
    Layout = null;
}


<!DOCTYPE html>

<html>

<head>

    <title>Edit Product Group</title>

    <link rel="stylesheet" href="~/css/ProductGroup/Edit.css" />

</head>


<body>


    <div class="page">


        <div class="form-card">


            <div class="form-header">


                <h1>
                    Edit Product Group
                </h1>


                <p>
                    Update product group information
                </p>


            </div>




            <input type="hidden" id="id" value="@ViewBag.Id" />





            <div class="form-group">


                <label>
                    Name
                </label>


                <input id="name"
                       placeholder="Enter group name" />


            </div>





            <div class="form-group">


                <label>
                    Description
                </label>


                <textarea id="description"
                          placeholder="Enter description"></textarea>


            </div>





            <div class="status-row">


                <label>
                    Active
                </label>


                <input type="checkbox"
                       id="isActive" />


            </div>





            <button onclick="updateProductGroup()">

                Save Changes

            </button>




        </div>


    </div>





    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>


    <script>


            let id = $("#id").val();





            $(document).ready(function() {


                loadProductGroup();


            });






            function loadProductGroup() {



                $.ajax({


                    url: "/api/product-groups/" + id,

                    type: "GET",


                    success: function(data) {


                        $("#name").val(data.name);


                        $("#description")
                            .val(data.description);


                        $("#isActive")
                            .prop(
                                "checked",
                                data.isActive
                            );


                    },


                    error: function() {


                        alert("Unable to load product group");


                    }



                });



            }








            function updateProductGroup() {



                let data = {


                    name: $("#name").val(),

                    description: $("#description").val(),

                    isActive:
                        $("#isActive").is(":checked")


                };





                $.ajax({


                    url: "/api/product-groups/" + id,


                    type: "PUT",


                    contentType: "application/json",


                    data: JSON.stringify(data),





                    success: function(response) {


                        alert(response.message);



                        window.location.href = "/ProductGroup/Index";



                    },



                    error: function() {


                        alert("Unable to update product group");


                    }



                });




            }



    </script>


</body>


</html>