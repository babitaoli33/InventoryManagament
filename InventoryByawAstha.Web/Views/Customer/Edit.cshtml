@model InventoryByawAstha.Web.ViewModels.Customer.CustomerEditViewModel

@{
    Layout = "_Layout";
}

<title>Edit Customer</title>

<link rel="stylesheet" href="~/css/Customer/Edit.css" />


<div class="page">

    <div class="header">

        <div>

            <h1>Edit Customer</h1>

            <p>
                Update customer information
            </p>

        </div>

        <div class="header-actions">

            <a href="/Customer/Index"
               class="back-btn">

                ← Back to Customers

            </a>

        </div>

    </div>


    <div class="form-card">

        <form id="customerEditForm">


            <!-- Customer ID -->

            <div class="form-group">

                <label>
                    Customer ID
                </label>

                <input type="text"
                       id="customerId"
                       value="@Model.CustomerId"
                       readonly />

            </div>


            <!-- Name -->

            <div class="form-group">

                <label for="name">
                    Name
                </label>

                <input type="text"
                       id="name"
                       placeholder="Enter customer name" />

            </div>


            <!-- Address -->

            <div class="form-group">

                <label for="address">
                    Address
                </label>

                <input type="text"
                       id="address"
                       placeholder="Enter customer address" />

            </div>


            <!-- Phone -->

            <div class="form-group">

                <label for="phone">
                    Phone
                </label>

                <input type="text"
                       id="phone"
                       placeholder="Enter phone number" />

            </div>


            <!-- Active -->

            <div class="form-group checkbox-group">

                <label>

                    <input type="checkbox"
                           id="isActive" />

                    Active

                </label>

            </div>


            <!-- Error -->

            <div id="errorMessage"
                 class="error-message">
            </div>


            <!-- Buttons -->

            <div class="form-actions">

                <a href="/Customer/Index"
                   class="cancel-btn">

                    Cancel

                </a>

                <button type="submit"
                        class="update-btn">

                    Update Customer

                </button>

            </div>


        </form>

    </div>

</div>


<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>


<script>

    $(document).ready(function () {

        loadCustomer();


        $("#customerEditForm").submit(function (event) {

            event.preventDefault();

            updateCustomer();

        });

    });


    // ==========================================
    // LOAD EXISTING CUSTOMER
    // ==========================================

    function loadCustomer() {

        const customerId =
            $("#customerId").val();


        $.ajax({

            url: "/api/customer/" + customerId,

            type: "GET",

            success: function (customer) {

                $("#name")
                    .val(customer.name);

                $("#address")
                    .val(customer.address);

                $("#phone")
                    .val(customer.phone);

                $("#isActive")
                    .prop(
                        "checked",
                        customer.isActive
                    );

            },

            error: function (xhr) {

                let message =
                    "Unable to load customer.";

                if (
                    xhr.responseJSON &&
                    xhr.responseJSON.message
                ) {

                    message =
                        xhr.responseJSON.message;

                }

                $("#errorMessage")
                    .text(message);

            }

        });

    }


    // ==========================================
    // UPDATE CUSTOMER
    // ==========================================

    function updateCustomer() {

        const customerId =
            $("#customerId").val();


        const model = {

            name:
                $("#name").val(),

            address:
                $("#address").val(),

            phone:
                $("#phone").val(),

            isActive:
                $("#isActive").is(":checked")

        };


        $.ajax({

            url: "/api/customer/" + customerId,

            type: "PUT",

            contentType: "application/json",

            data:
                JSON.stringify(model),

            success: function () {

                window.location.href =
                    "/Customer/Index";

            },

            error: function (xhr) {

                let message =
                    "Unable to update customer.";

                if (
                    xhr.responseJSON &&
                    xhr.responseJSON.message
                ) {

                    message =
                        xhr.responseJSON.message;

                }

                $("#errorMessage")
                    .text(message);

            }

        });

    }

</script>