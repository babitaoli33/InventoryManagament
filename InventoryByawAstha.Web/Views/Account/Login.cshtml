@model InventoryByawAstha.BLL.src.DTOs.AuthDTOs.LoginDTO

@{
    Layout = null;
}

<!DOCTYPE html>

<html>

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>Login</title>

    <link rel="stylesheet"
          href="~/css/Account/Login.css" />
 

</head>

<body>

 
    <div class="login-wrap">

        <div class="login-card">

            <img class="logo"
                 src="~/img/Logo.png"
                 alt="Inventory Logo" />

            <br />

            <p>
                Welcome Back
            </p>


            <div class="form-group">

                <label>
                    Email
                </label>

                <input id="email"
                       class="input"
                       type="email"
                       placeholder="Enter email" />

            </div>


            <div class="form-group">

                <label>
                    Password
                </label>

                <input id="password"
                       type="password"
                       class="input"
                       placeholder="Enter password" />

            </div>


            <div id="errorMessage"
                 class="validation">
            </div>


            <button type="button"
                    onclick="login()"
                    class="login-btn">

                Login

            </button>

        </div>

    </div>


    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>


    <script>

            function login() {

                var loginData = {
                    email: $("#email").val(),
                    password: $("#password").val()
                };


                $("#errorMessage").text("");


                $.ajax({

                    url: "/api/auth/login",

                    type: "POST",

                    contentType: "application/json",

                    data: JSON.stringify(loginData),


                    success: function(response) {

                      
                        localStorage.setItem(
                            "accessToken",
                            response.accessToken
                        );


                   
                        localStorage.setItem(
                            "refreshToken",
                            response.refreshToken
                        );


                     
                        window.location.href = "/Dashboard/Index";

                    },


                    error: function(xhr) {

                        if (
                            xhr.responseJSON &&
                            xhr.responseJSON.message
                        ) {

                            $("#errorMessage")
                                .text(xhr.responseJSON.message);

                        }
                        else {

                            $("#errorMessage")
                                .text("Something went wrong");

                        }

                    }

                });

            }

    </script>
  

</body>

</html>
