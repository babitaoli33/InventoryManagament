@{
    Layout = null;
}

<!DOCTYPE html>

<html>

<head>

    <title>Edit Unit of Measure</title>

    <link rel="stylesheet" href="~/css/UnitOfMeasure/Edit.css" />

</head>


<body>


    <div class="page">


        <div class="form-card">


            <div class="form-header">

                <h1>
                    Edit Unit of Measure
                </h1>

                <p>
                    Update unit of measure information
                </p>

            </div>




            <input type="hidden" id="id" value="@ViewBag.Id" />





            <div class="form-group">

                <label>
                    Name
                </label>

                <input id="name"
                       placeholder="Enter unit name" />

            </div>





            <div class="form-group">

                <label>
                    Code
                </label>

                <input id="code"
                       placeholder="Enter unit code" />

            </div>





            <div class="form-group">

                <label>
                    Description
                </label>

                <textarea id="description"
                          placeholder="Enter description"></textarea>

            </div>





            <div class="status-row">

                <label>
                    Active
                </label>


                <input type="checkbox"
                       id="isActive" />

            </div>





            <button onclick="updateUom()">

                Save Changes

            </button>




        </div>


    </div>





    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>


    <script>


            let id = $("#id").val();



            $(document).ready(function() {

                loadUom();

            });






            function loadUom() {



                $.ajax({


                    url: "/api/unitofmeasure/" + id,

                    type: "GET",



                    success: function(data) {


                        console.log(data);



                        $("#name").val(data.name ?? "");

                        $("#code").val(data.code ?? "");

                        $("#description")
                            .val(data.description ?? "");


                        $("#isActive")
                            .prop(
                                "checked",
                                data.isActive
                            );



                    },



                    error: function(xhr) {


                        console.log(xhr.responseText);


                        alert("Unable to load unit of measure");


                    }



                });



            }








            function updateUom() {



                let data = {


                    name: $("#name").val(),

                    code: $("#code").val(),

                    description: $("#description").val(),

                    isActive:
                        $("#isActive").is(":checked")

                };





                $.ajax({


                    url: "/api/unitofmeasure/" + id,


                    type: "PUT",


                    contentType: "application/json",


                    data: JSON.stringify(data),




                    success: function(response) {


                        alert(response.message);


                        window.location.href = "/UnitOfMeasure/Index";


                    },




                    error: function(xhr) {


                        console.log(xhr.responseText);


                        alert("Unable to update unit of measure");


                    }



                });



            }



    </script>


</body>

</html>