@model InventoryByawAstha.BLL.src.DTOs.UserDTOs.CreateUserDTO

@{
    Layout = null;
}


<!DOCTYPE html>

<html>

<head>

    <title>Add User</title>

    <link rel="stylesheet" href="~/css/User/CreateUser.css" />

</head>


<body>


    <div class="center-page">


        <div class="glass-card">


            <h1>
                Create User
            </h1>


            <p>
                Add a new system user
            </p>



            <form asp-action="CreateUser" method="post">


                <div class="form-group">

                    <label>Name</label>

                    <input asp-for="Name"
                           class="input"
                           placeholder="Enter name" />

                    <span asp-validation-for="Name"
                          class="validation"></span>

                </div>




                <div class="form-group">

                    <label>Email</label>

                    <input asp-for="Email"
                           class="input"
                           placeholder="Enter email" />


                    <span asp-validation-for="Email"
                          class="validation"></span>

                </div>

                <div class="form-group">
                    <label>Password</label>
                    <input asp-for="Password" type="password" class="input" placeholder="Enter password" />
                    <span asp-validation-for="Password" class="validation"></span>
                </div>


                <div class="form-group">

                    <label>Mobile</label>

                    <input asp-for="PhNumber"
                           class="input"
                           placeholder="Enter mobile number" />


                    <span asp-validation-for="PhNumber"
                          class="validation"></span>

                </div>
                <div class="form-group">

                    <label>Role</label>

                    <select asp-for="Role" class="input">

                        <option value="User">
                            User
                        </option>

                        <option value="Staff">
                            Staff
                        </option>

                        <option value="Admin">
                            Admin
                        </option>

                    </select>

                    <span asp-validation-for="Role"
                          class="validation"></span>

                </div>


                <div class="form-actions">


                    <button class="create-btn">

                        Save User

                    </button>



                    <a asp-action="Index"
                       class="cancel-btn">

                        Cancel

                    </a>


                </div>



            </form>



        </div>


    </div>


</body>

</html>